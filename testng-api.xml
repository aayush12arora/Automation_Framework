<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- API suite: runs the "api" group against a configured API target.
     The API base URL comes from the active application's apiBaseUrl, so choose
     the application on the command line:
         mvn test -DsuiteXmlFile=testng-api.xml -Dapplication=jsonplaceholder -->
<suite name="API Suite" verbose="1">

    <listeners>
        <listener class-name="com.automation.framework.reporting.TestListener"/>
    </listeners>

    <test name="REST API">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.framework.tests.api.JsonPlaceholderApiTest"/>
        </classes>
    </test>

</suite>
