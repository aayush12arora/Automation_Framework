<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Default suite. Runs the smoke group against the configured application
  (default: gyansathi). Override at runtime, e.g.:
      mvn test -Dapplication=gyansathi -Denvironment=prod -Dbrowser=chrome -Dheadless=true
  Parallelism is by methods; thread-count is safe because the driver is
  thread-local (see DriverManager).
-->
<!--
  TestListener is registered globally via ServiceLoader
  (src/test/resources/META-INF/services/org.testng.ITestNGListener) so that it
  also fires for single-test runs launched from the IDE or via
  `mvn test -Dtest=Class#method`. Do NOT also list it here, or every test would
  be logged to the report twice.
-->
<suite name="Automation Suite" verbose="1" parallel="methods" thread-count="3">

    <test name="UI Smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.automation.framework.tests.ui.GyanSathiSmokeTest"/>
            <class name="com.automation.framework.tests.ui.GyanSathiLoginTest"/>
            <class name="com.automation.framework.tests.ui.FlowDrivenTest"/>
        </classes>
    </test>

</suite>
